{
  "name": "dsh-codex-account-switcher",
  "version": "1.4.0",
  "type": "module",
  "description": "Snapshot and switch the Codex login used by the Codex subagent, and read its usage quota from the Plugins page.",
  "license": "MIT",
  "author": "BuildWithAIHub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildWithAIHub/dsh-codex-account-switcher.git"
  },
  "homepage": "https://github.com/BuildWithAIHub/dsh-codex-account-switcher#readme",
  "bugs": {
    "url": "https://github.com/BuildWithAIHub/dsh-codex-account-switcher/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "account-switcher",
    "quota",
    "usage"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "quota.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
